@model RentIO.Models.Rezervacija

@{
    ViewData["Title"] = "Detalji rezervacije";
}

<h2>Rezervacija #@Model.Id</h2>
<hr />

@* ===== MASTER: Podaci o rezervaciji ===== *@
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Podaci o rezervaciji</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Gost</dt>
            <dd class="col-sm-9">@Model.Gost?.Ime @Model.Gost?.Prezime (@Model.Gost?.Email)</dd>

            <dt class="col-sm-3">Apartman</dt>
            <dd class="col-sm-9">@Model.Apartman?.Naziv — @Model.Apartman?.Lokacija</dd>

            <dt class="col-sm-3">Datum dolaska</dt>
            <dd class="col-sm-9">@Model.DatumDolaska.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Datum odlaska</dt>
            <dd class="col-sm-9">@Model.DatumOdlaska.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Broj noći</dt>
            <dd class="col-sm-9">@((Model.DatumOdlaska - Model.DatumDolaska).Days)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == RentIO.Models.StatusRezervacije.Potvrđena ? "bg-success" :
                                     Model.Status == RentIO.Models.StatusRezervacije.Otkazana ? "bg-danger" : "bg-warning text-dark")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Ukupna cijena</dt>
            <dd class="col-sm-9"><strong>@Model.UkupnaCijena.ToString("N2") €</strong></dd>
        </dl>
    </div>
</div>

@* ===== DETAIL: Usluge ===== *@
<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Dodatne usluge</h5>
    </div>
    <div class="card-body">
        @if (Model.RezervacijaUsluge.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Usluga</th>
                        <th>Cijena/jed. (€)</th>
                        <th>Količina</th>
                        <th>Subtotal (€)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ru in Model.RezervacijaUsluge)
                    {
                        <tr>
                            <td>@ru.Usluga?.Naziv</td>
                            <td>@ru.Usluga?.CijenaPoJedinici.ToString("N2")</td>
                            <td>@ru.Kolicina</td>
                            <td>@((ru.Usluga?.CijenaPoJedinici ?? 0 * ru.Kolicina).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">Nema dodatnih usluga.</p>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Uredi</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Natrag</a>
</div>
