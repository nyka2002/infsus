@model RentIO.Models.Usluga
@{ ViewData["Title"] = "Brisanje usluge"; }

<h2>Potvrda brisanja</h2>
<hr />

<div class="alert alert-danger">Jeste li sigurni da želite obrisati ovu uslugu?</div>

<dl class="row">
    <dt class="col-sm-3">Naziv</dt>
    <dd class="col-sm-9">@Model.Naziv</dd>
    <dt class="col-sm-3">Cijena/jed.</dt>
    <dd class="col-sm-9">@Model.CijenaPoJedinici.ToString("N2") €</dd>
</dl>

<form asp-action="Delete">
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Da, obriši</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
    </div>
</form>
