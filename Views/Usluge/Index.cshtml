@model IEnumerable<RentIO.Models.Usluga>
@{ ViewData["Title"] = "Usluge"; }

<h2>Usluge</h2>

<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                   class="form-control" placeholder="Pretraži po nazivu..." />
            <button type="submit" class="btn btn-outline-primary">Traži</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Resetiraj</a>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">+ Nova usluga</a>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Naziv</th>
            <th>Opis</th>
            <th>Cijena/jed. (€)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Naziv</td>
                <td>@u.Opis</td>
                <td>@u.CijenaPoJedinici.ToString("N2")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Uredi</a>
                    <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-danger">Briši</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Nema usluga. <a asp-action="Create">Dodajte prvu uslugu.</a></div>
}
